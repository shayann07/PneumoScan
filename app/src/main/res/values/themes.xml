<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PneumoScan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand -->
        <item name="colorPrimary">@color/pneumo_primary</item>
        <item name="colorPrimaryVariant">@color/pneumo_primary_variant</item>
        <item name="colorOnPrimary">@color/pneumo_onPrimary</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/pneumo_secondary</item>
        <item name="colorOnSecondary">@color/pneumo_onPrimary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/pneumo_background</item>
        <item name="colorSurface">@color/pneumo_surface</item>
        <item name="colorOnSurface">@color/pneumo_onSurface</item>

        <!-- Additional reusable attributes -->
<!--        <item name="pneumo_muted">@color/pneumo_muted</item>-->
    </style>

    <style name="Theme.PneumoScan" parent="Base.Theme.PneumoScan" />

    <style name="Theme.PneumoScan.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorPrimary">@color/pneumo_primary</item>
        <item name="colorPrimaryVariant">@color/pneumo_primary_variant</item>
        <item name="colorOnPrimary">@color/pneumo_onPrimary</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/pneumo_secondary</item>
        <item name="colorOnSecondary">@color/pneumo_onPrimary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/pneumo_background</item>
        <item name="colorSurface">@color/pneumo_surface</item>
        <item name="colorOnSurface">@color/pneumo_onSurface</item>
    </style>
</resources>